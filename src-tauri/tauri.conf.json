{
  "productName": "SecureVault",
  "version": "1.8.0",
  "identifier": "com.securevault.desktop",
  "build": {
    "beforeDevCommand": "npm run tauri:dev",
    "beforeBuildCommand": "npm run tauri:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SecureVault",
        "width": 1100,
        "height": 760,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "perMachine"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNDUyNTdDM0UwRjgzMUQKUldRZGd3OCtmQ1ZGa3F4TG9LNnRrM29DSkV0QlFDbURjOW1JN1BpNGpZQVVtbkxhOFVON3dIMk8K",
      "endpoints": [
        "https://github.com/NovanJex/SecureVault/releases/latest/download/latest.json"
      ]
    }
  }
}
